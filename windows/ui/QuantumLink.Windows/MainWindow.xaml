<Window
    x:Class="QuantumLink.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuantumLink.Windows.Models"
    Title="QuantumLink">

    <ScrollViewer>
        <Grid Padding="24" RowSpacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Padding="20"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="QuantumLink"
                                       Style="{StaticResource TitleTextBlockStyle}" />
                            <Border Padding="8,3"
                                    CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.PlatformBadge, Mode=OneWay}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           FontSize="12" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ReadinessSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <Button Content="Refresh status"
                                Command="{x:Bind ViewModel.RefreshStatusCommand}" />
                        <Button Content="Connect"
                                Command="{x:Bind ViewModel.ConnectTunnelCommand}"
                                Visibility="{x:Bind ViewModel.ConnectButtonVisibility, Mode=OneWay}" />
                        <Button Content="Disconnect"
                                Command="{x:Bind ViewModel.DisconnectTunnelCommand}"
                                Visibility="{x:Bind ViewModel.DisconnectButtonVisibility, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Phase" Opacity="0.6" />
                        <TextBlock Text="{x:Bind ViewModel.Phase, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Onboarding checklist -->
                <Border Grid.Column="0"
                        Padding="18"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Onboarding Checklist"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OnboardingItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE73E;"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Connection status -->
                <Border Grid.Column="1"
                        Padding="18"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Connection Status"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="18" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Path" Opacity="0.6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PathType, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Route mode" Opacity="0.6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.RouteMode, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DNS mode" Opacity="0.6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DnsMode, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Overlay address" Opacity="0.6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.OverlayAddress, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Protected routes" Opacity="0.6" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.RouteSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Peers" Opacity="0.6" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.PeerSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Traffic" Opacity="0.6" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.TrafficSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Kill switch" Opacity="0.6" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.KillSwitchEngaged, Mode=OneWay}" />
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Service" Opacity="0.6" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.ServiceState, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Last error" Opacity="0.6" />
                            <TextBlock Grid.Row="9" Grid.Column="1"
                                       Text="{x:Bind ViewModel.LastError, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Identity and policy summaries -->
                <Border Grid.Column="0"
                        Padding="18"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Identity &amp; Policy"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Identity" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.TrustSummary, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Registry" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.RegistrySummary, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Route Policy" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.PolicySummary, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Help topics -->
                <Border Grid.Column="1"
                        Padding="18"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Help Topics"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.HelpSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HelpTopics, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE946;"
                                                  FontSize="12"
                                                  Opacity="0.7" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="18"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Transport"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TransportSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="18"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Packet Pump"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PacketPumpSummary, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Opacity="0.75" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Peers -->
            <Border Grid.Row="4"
                    Padding="18"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Peers"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ListView ItemsSource="{x:Bind ViewModel.Peers, Mode=OneWay}"
                              SelectionMode="None"
                              MaxHeight="260">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PeerStatus">
                                <Grid Padding="0,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Identity.PeerId}"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind PathType}"
                                               Opacity="0.65"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind OverlayAddress}"
                                               Opacity="0.65"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Grid.Row="5"
                    Padding="18"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Redacted support export"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Content="Generate redacted JSON"
                                Command="{x:Bind ViewModel.ExportDiagnosticsCommand}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxHeight="220" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>

# Copy to /etc/quantumlink/public-edge.env on the edge host.
# Public rendezvous and QuantumLink relay should use `qlinkctl` built with
# `--features public-edge-tls`, service-token credential files, conservative
# source limits, and the relay quota defaults below.

# Operator scripts may source this; systemd unit ExecStart paths use the
# absolute binary path directly because systemd cannot expand an environment
# variable as the executable.
QLINK_BIN=/opt/quantumlink/bin/qlinkctl

# QuantumLink control-plane listeners.
QLINK_RENDEZVOUS_LISTEN=0.0.0.0:9471
QLINK_RELAY_LISTEN=0.0.0.0:9472
QLINK_RENDEZVOUS_TLS_CERT=/etc/quantumlink/tls/control.crt
QLINK_RENDEZVOUS_TLS_KEY=/etc/quantumlink/tls/control.key
QLINK_RELAY_TLS_CERT=/etc/quantumlink/tls/control.crt
QLINK_RELAY_TLS_KEY=/etc/quantumlink/tls/control.key

# QuantumLink rendezvous/relay admission tokens live in stable credential
# files, not process arguments. qlinkctl rereads these files per admission
# check so operators can rotate tokens without restarting the service.
QLINK_RENDEZVOUS_AUTH_TOKEN_FILE=/etc/quantumlink/secrets/rendezvous-auth-token
QLINK_RELAY_AUTH_TOKEN_FILE=/etc/quantumlink/secrets/relay-auth-token
QLINK_RENDEZVOUS_REVOKED_AUTH_TOKEN_DIGEST_FILE=/etc/quantumlink/secrets/rendezvous-revoked-auth-token-digests
QLINK_RELAY_REVOKED_AUTH_TOKEN_DIGEST_FILE=/etc/quantumlink/secrets/relay-revoked-auth-token-digests
QLINK_RENDEZVOUS_RATE_LIMIT_PER_WINDOW=120
QLINK_RELAY_RATE_LIMIT_PER_WINDOW=240
QLINK_ADMISSION_RATE_LIMIT_WINDOW_SECONDS=60

# Service-level OpenMetrics endpoints. Keep these on loopback and scrape with a
# local collector or SSH tunnel; do not expose them in the public firewall.
QLINK_RENDEZVOUS_METRICS_ADDR=127.0.0.1:9571
QLINK_RELAY_METRICS_ADDR=127.0.0.1:9572

# Public-edge service bounds. These keep control-plane requests and relay
# registrations finite while named-tester beta access is still source-limited.
QLINK_MAX_REQUEST_LINE_BYTES=131072
QLINK_MAX_CONCURRENT_CONNECTIONS=1024
QLINK_IDLE_TIMEOUT_SECONDS=300
QLINK_RELAY_MAX_PAYLOAD_BYTES=65536
QLINK_RELAY_MAX_PEER_ID_BYTES=256
QLINK_RELAY_MAX_REGISTERED_PEERS=2048
QLINK_RELAY_MAX_PEER_DATAGRAMS_PER_WINDOW=120
QLINK_RELAY_PEER_DATAGRAM_WINDOW_SECONDS=60

# coturn owns UDP 3478 for public STUN/TURN allocation. The in-repo STUN
# helpers use auxiliary UDP ports for NAT classification from multiple
# destinations without racing coturn for the same socket.
QLINK_STUN_PRIMARY_LISTEN=0.0.0.0:3479
QLINK_STUN_SECONDARY_LISTEN=0.0.0.0:3480

# coturn template values. Generate a high-entropy password before deployment.
QLINK_TURN_REALM=turn.quantumlink.example
QLINK_TURN_USERNAME=qlink-turn
QLINK_TURN_PASSWORD=replace-with-32-plus-random-chars
QLINK_TURN_LISTENING_IP=0.0.0.0
QLINK_TURN_EXTERNAL_IP=203.0.113.10
QLINK_TURN_MIN_PORT=49160
QLINK_TURN_MAX_PORT=49200
QLINK_TURN_CERT=/etc/turnserver/turn_server_cert.pem
QLINK_TURN_PKEY=/etc/turnserver/turn_server_pkey.pem

# Off-host evidence helpers. These are for tester-side env files used by
# scripts/public-edge-live-evidence.sh; systemd units ignore them.
# QLINK_PUBLIC_EDGE_HOST=edge.quantumlink.example
# QLINK_CONTROL_TLS_CA=/path/to/control-ca-or-public-chain.pem
# QLINK_RENDEZVOUS_AUTH_TOKEN_FILE=/path/to/rendezvous-auth-token
# QLINK_RELAY_AUTH_TOKEN_FILE=/path/to/relay-auth-token
# QLINK_RENDEZVOUS_REVOKED_AUTH_TOKEN_DIGEST_FILE=/path/to/rendezvous-revoked-auth-token-digests
# QLINK_RELAY_REVOKED_AUTH_TOKEN_DIGEST_FILE=/path/to/relay-revoked-auth-token-digests
# QLINK_RENDEZVOUS_REPLACEMENT_AUTH_TOKEN_FILE=/path/to/rendezvous-auth-token.next
# QLINK_RELAY_REPLACEMENT_AUTH_TOKEN_FILE=/path/to/relay-auth-token.next
# QLINK_TURN_PASSWORD_FILE=/path/to/turn-password
# QLINK_TURN_PERMIT_PEER_IP=198.51.100.44
# QLINK_PUBLIC_EDGE_RELEASE_ID=public-edge-current-release
# QLINK_PREVIOUS_RELEASE_ID=public-edge-previous-release
# QLINK_ROLLBACK_MANIFEST=/path/to/rollback-manifest.json

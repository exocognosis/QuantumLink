# Replace TESTER_CIDR with the current tester egress CIDR before applying.
# Rendezvous and QuantumLink relay are raw TCP today, so keep them source
# allowlisted or tunnel them over WireGuard/SSH.

ufw allow from TESTER_CIDR to any port 9471 proto tcp comment 'QuantumLink rendezvous allowlisted'
ufw allow from TESTER_CIDR to any port 9472 proto tcp comment 'QuantumLink PQC relay allowlisted'

# coturn on 3478 provides public STUN/TURN discovery/allocation. The in-repo
# STUN helpers live on auxiliary ports for two-destination NAT classification.
ufw allow 3478/udp comment 'QuantumLink coturn STUN/TURN UDP'
ufw allow 3479:3480/udp comment 'QuantumLink auxiliary STUN UDP'
ufw allow 5349/tcp comment 'QuantumLink TURN TLS'
ufw allow 49160:49200/udp comment 'QuantumLink TURN relay ports'

# Metrics, service logs, and any admin endpoints stay localhost/SSH only.

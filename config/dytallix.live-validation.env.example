# QuantumLink live Dytallix validation defaults.
# Source this file or copy the values into your shell before running:
#   scripts/dytallix-live-validation.sh

# Public Dytallix testnet gateway.
QL_DYTALLIX_ENDPOINT=https://dytallix.com

# Optional: install the CLI from Git when `dytallix` is not already on PATH.
QL_DYTALLIX_INSTALL_CLI=0

# Optional: path to a prebuilt CLI binary.
# QL_DYTALLIX_CLI=/path/to/dytallix

# Isolated validation state. The script sets HOME to this directory for CLI calls.
QL_DYTALLIX_WORKDIR=build/dytallix-live-validation

# Read-only by default. Set to 1 to run `dytallix init`, faucet, wallet info, and balance.
QL_DYTALLIX_MUTATE=0

# Optional transfer validation. Requires QL_DYTALLIX_MUTATE=1 and a recipient D-Addr.
QL_DYTALLIX_VALIDATE_TRANSFER=0
# QL_DYTALLIX_RECIPIENT_DADDR=dyt1...

# QuantumLink registry contract checks. Required before public-mesh launch validation can
# prove node-registration semantics against a deployed contract.
QL_DYTALLIX_REGISTRY_CONTRACT=0x60e5c1a57ef0d3ccfe56d8641e50cc35532bb592
# QL_DYTALLIX_REGISTRY_QUERY_METHOD=...
# QL_DYTALLIX_REGISTRY_QUERY_ARGS="..."

# Optional QuantumLink node identity under test.
# QL_QUANTUMLINK_PEER_ID=qlink_...

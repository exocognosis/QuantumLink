#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "quantumlink-service-control requires root" >&2
    exit 1
fi

if [ "$#" -ne 1 ]; then
    echo "usage: quantumlink-service-control <start|stop|restart>" >&2
    exit 2
fi

case "$1" in
    start|stop|restart)
        exec /usr/bin/systemctl "$1" qlinkd.service
        ;;
    *)
        echo "unsupported QuantumLink service action: $1" >&2
        exit 2
        ;;
esac

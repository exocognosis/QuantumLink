[Unit]
Description=QuantumLink gaming mesh VPN daemon
Documentation=https://github.com/exocognosis/QuantumLink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Default packaged mode is dry-run planning-only. It validates and publishes the
# intended network plan but does not apply TUN, route, or nftables changes.
# Use a systemd drop-in that overrides ExecStart with
# /usr/local/bin/qlinkd --activate-network for real network application.
ExecStart=/usr/local/bin/qlinkd
# Stop is record-backed and idempotent. It is a no-op for the default dry-run
# service and tears down only qlink-owned network state after activated runs.
ExecStop=/usr/local/bin/qlinkd --deactivate-network
# Backstop cleanup for crashes and start failures; this is idempotent when no
# activated ownership record exists.
ExecStopPost=/usr/local/bin/qlinkd --deactivate-network
Restart=on-failure
RestartSec=2s
Group=quantumlink
RuntimeDirectory=quantumlink
RuntimeDirectoryMode=0750
StateDirectory=quantumlink
StateDirectoryMode=0750
ConfigurationDirectory=quantumlink
ConfigurationDirectoryMode=0750
UMask=0007
NoNewPrivileges=no

# Keep the service root-owned while activated networking, state, and the local
# control socket still use the privileged SteamOS packaging path. The
# quantumlink group is limited to local status/doctor socket access.

[Install]
WantedBy=multi-user.target

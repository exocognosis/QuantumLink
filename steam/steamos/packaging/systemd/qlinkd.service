[Unit]
Description=QuantumLink gaming mesh VPN daemon
Documentation=https://github.com/exocognosis/QuantumLink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The production-candidate service applies the owned TUN, route, and nftables
# plan. Startup fails closed when the config cannot produce a safe plan.
ExecStart=/usr/local/bin/qlinkd --activate-network
# Stop is record-backed and idempotent. It is a no-op for planning-only starts
# and tears down only qlink-owned network state after activated runs.
ExecStop=/usr/local/bin/qlinkd --deactivate-network
# Backstop cleanup for crashes and start failures; this is idempotent when no
# activated ownership record exists.
ExecStopPost=/usr/local/bin/qlinkd --deactivate-network
Restart=on-failure
RestartSec=2s
Group=quantumlink
RuntimeDirectory=quantumlink
RuntimeDirectoryMode=0750
StateDirectory=quantumlink
StateDirectoryMode=0750
ConfigurationDirectory=quantumlink
ConfigurationDirectoryMode=0750
UMask=0007
NoNewPrivileges=no

# Keep the service root-owned while activated networking, state, and the local
# control socket still use the privileged SteamOS packaging path. The
# quantumlink group is limited to status, diagnostics, and validated game
# profile selection through the local control socket.

[Install]
WantedBy=multi-user.target
